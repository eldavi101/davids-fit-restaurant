# ---------------------------------------------------------------------------
# Equity Signal Tracker — backend environment
# Copy to .env and fill in.  NEVER commit .env.  NEVER put any of these in the APK.
#
#   ./scripts/setup.sh   generates this file with fresh secrets for you.
# ---------------------------------------------------------------------------

# --- Application ---
APP_ENV=development                 # development | production
LOG_LEVEL=INFO
# Comma-separated. The Android app sends one of these as X-API-Key.
# Generate one with:  openssl rand -hex 32
API_KEYS=
CORS_ORIGINS=*

# --- Database ---
# SQLite is the default so a laptop can run the backend with no extra service.
# Production uses Postgres; docker-compose builds this URL from POSTGRES_PASSWORD.
DATABASE_URL=sqlite:///./equity_signal.db
# Used by docker-compose for both the postgres container and the API's DATABASE_URL.
POSTGRES_PASSWORD=

# --- Market data providers -------------------------------------------------
# Pick the active provider and supply only that provider's key.
# Options: synthetic | polygon | finnhub | fmp | twelvedata | alphavantage
#
# `synthetic` generates deterministic prices for demos and tests. They are NOT real
# market data, are labelled SYNTHETIC everywhere they surface, and must never be traded
# on. Set a real vendor here for live signals.
MARKET_DATA_PROVIDER=synthetic
# Ordered failover list (comma separated). Leave empty to disable failover.
MARKET_DATA_FALLBACKS=

POLYGON_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=

# Client-side pacing, in requests per minute. 0 = use the adapter's own default for that
# vendor (polygon 100, finnhub 60, fmp 200, twelvedata 8, alphavantage 5). Set this to the
# limit your plan actually grants: pacing here is what stops a universe refresh from
# spending the whole minute budget in one second and collecting 429s.
MARKET_DATA_RATE_LIMIT_PER_MINUTE=0

# --- Trading mode ----------------------------------------------------------
# The system is signal-only. There is no broker integration and no order routing.
PAPER_TRADING=true
PAPER_STARTING_EQUITY=100000

# --- Scheduler -------------------------------------------------------------
ENABLE_SCHEDULER=true
SCAN_INTERVAL_MINUTES=30            # full universe scan cadence during market hours
MONITOR_INTERVAL_MINUTES=5          # open-alert monitoring cadence
UNIVERSE_REFRESH_HOUR_ET=7          # daily universe rebuild, America/New_York

# --- Data quality ----------------------------------------------------------
MAX_BAR_AGE_MINUTES=120             # bars older than this block NEW buy signals
MIN_BARS_REQUIRED=252
# Ceiling on symbols considered per universe refresh. 0 = no ceiling. A vendor lists
# ~10k U.S. symbols; each one that survives the exchange/security-type filters costs a
# history request, so on a slow plan start with a few thousand.
UNIVERSE_MAX_SYMBOLS=0

# --- Strategy --------------------------------------------------------------
STRATEGY_VERSION=momentum_breakout_v1.0.0

# --- Deployment (docker-compose only) --------------------------------------
# Hostname for the Caddy TLS profile; must already resolve to this server.
PUBLIC_DOMAIN=
# Set to 127.0.0.1 when Caddy terminates TLS, so port 8000 is not exposed directly.
API_BIND_HOST=0.0.0.0
